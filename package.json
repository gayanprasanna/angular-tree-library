{
  "name": "gp-tree-view-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo-app",
    "build": "ng build angular-tree",
    "build:demo": "ng build demo-app",
    "build:all": "ng build angular-tree && ng build demo-app",
    "watch": "ng build angular-tree --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "pack": "cd dist/angular-tree && npm pack",
    "publish:lib": "npm run build && cd dist/angular-tree && npm publish",
    "deploy": "ng build demo-app --configuration production --base-href /angular-tree-library/ && npx angular-cli-ghpages --dir=dist/demo-app/browser",
    "deploy:setup": "ng build demo-app --configuration production --base-href /angular-tree-library/"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.4",
    "@angular/cli": "^20.3.4",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "angular-cli-ghpages": "^2.0.3",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.3.0",
    "typescript": "~5.9.2"
  }
}
